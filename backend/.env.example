# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# `.env` is gitignored, so your real key never gets committed.
# Values here are read by `src/config/env.js`, which loads `.env` with
# `override: true` — a local `.env` always wins over a stale OS-level
# environment variable of the same name.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the Express server listens on (1-65535).
PORT=3000

# development | production | test
NODE_ENV=development

# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------

# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model id. `gemini-3.8-flash` is the current default.
# Note: `gemini-2.5-flash` has been retired for new projects and now errors
# with "no longer available to new users".
GEMINI_MODEL=gemini-3.8-flash

# Base URL for the Generative Language API.
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Request timeout for Gemini calls, in milliseconds.
GEMINI_TIMEOUT_MS=30000
